{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "trailingComma": "all",
  "bracketSameLine": false,
  "singleAttributePerLine": false,
  "sortTailwindcss": {
    "functions": ["cn", "tw"],
    "preserveDuplicates": false,
    "preserveWhitespace": false
  },
  "ignorePatterns": ["pnpm-lock.yaml"]
}
