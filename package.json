{
  "name": "resume-chat",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "analyze": "next analyze",
    "build": "next build",
    "build:test": "node scripts/build-fixture.mjs",
    "dev": "portless run next dev",
    "lint": "oxlint",
    "format": "oxfmt --write src/ scripts/ test/",
    "format:check": "oxfmt --check src/ scripts/ test/",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint:fix": "oxlint --fix",
    "prepare": "husky"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.78",
    "@ai-sdk/react": "4.0.157",
    "@base-ui/react": "^1.9.0",
    "@opentelemetry/api": "^1.10.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/analytics": "^2.0.1",
    "ai": "7.0.153",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.61.0",
    "next": "^16.4.3",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "streamdown": "^2.7.1",
    "tailwindcss": "^4.3.3",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@aranlucas/oxforge": "^0.3.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tailwindcss": "^1.16.0",
    "oxlint-tsgolint": "^7.0.2005",
    "portless": "0.15.12",
    "postcss": "^8.5.31",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,json5,css,scss,md,mdx,yml,yaml,html,toml,vue,svelte,astro,graphql}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "packageManager": "pnpm@12.14.0"
}
