{
  "name": "resume-chat",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "analyze": "next analyze",
    "build": "next build",
    "build:test": "node scripts/build-fixture.mjs",
    "dev": "portless run next dev",
    "lint": "oxlint",
    "format": "oxfmt --write src/ scripts/",
    "format:check": "oxfmt --check src/ scripts/",
    "start": "next start",
    "test": "vitest",
    "test:node": "node --test --test-concurrency=1 src/lib/*.test.mjs && tsx --test src/lib/*.test.ts src/app/api/chat/*.test.ts",
    "test:all": "vitest run && npm run test:node",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.137",
    "@base-ui/react": "^1.8.0",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/analytics": "^2.0.1",
    "ai": "7.0.134",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.53.0",
    "next": "^16.4.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "streamdown": "^2.7.0",
    "tailwindcss": "^4.3.3",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "portless": "0.15.7",
    "postcss": "^8.5.29",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.10.1"
}
